# Copy this file to ".env" (same folder as court_worker.exe) and fill in the three values you were given.
# DO NOT change anything else, and do not share this file - it contains passwords.

REDIS_URL=redis://default:PASSWORD@HOST:PORT
SHEETS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_SECRET=THE_SECRET_YOU_WERE_GIVEN

# --- shared job settings: keep exactly as given (the program refuses to start if they differ) ---
COURT_CODE=D57
DATE_FROM=2024-10-01T18:30:00.000Z
DATE_TO=2025-10-01T18:30:00.000Z

# --- this machine ---
CAPTCHA_MODE=local            # the person at this PC solves CAPTCHAs; other workers keep going
BATCH_SIZE=10
FLUSH_SECONDS=15
NO_RESULTS_TEXT=no results,no records,no cases found,0 results

# Alerts are sent to the owner through Redis. No WhatsApp credentials are needed (or wanted) here.
NOTIFY_ENABLED=true
